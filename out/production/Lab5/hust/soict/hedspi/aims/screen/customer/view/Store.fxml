<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="hust.soict.hedspi.aims.screen.customer.controller.StoreController"
            prefWidth="1024" prefHeight="768">
    <top>
        <VBox spacing="10" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="20" right="20" bottom="10" left="20"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="AIMS" style="-fx-font-size: 40; -fx-text-fill: #00BFFF; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="View Cart" onAction="#viewCart"/>
            </HBox>

            <Separator/>
        </VBox>
    </top>

    <!-- Danh sách sản phẩm -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <content>
                <GridPane fx:id="gridPane" hgap="10" vgap="10">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                </GridPane>
            </content>
        </ScrollPane>
    </center>

</BorderPane>